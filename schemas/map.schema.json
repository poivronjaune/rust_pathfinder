{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/poivronjaune/rust_pathfinder/main/schemas/map.schema.json",
  "title": "Rust Pathfinder map",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "rows": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100
    },
    "columns": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100
    },
    "start": {
      "$ref": "#/$defs/start"
    },
    "cells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 100,
        "items": {
          "$ref": "#/$defs/cell"
        }
      }
    }
  },
  "required": ["formatVersion", "rows", "columns", "cells"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "formatVersion": {
            "enum": [1, 2]
          }
        },
        "required": ["formatVersion"]
      },
      "then": {
        "properties": {
          "cells": {
            "items": {
              "items": {
                "enum": ["free", "obstacle", "unknown"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "formatVersion": {
            "const": 3
          }
        },
        "required": ["formatVersion"]
      },
      "then": {
        "required": ["start"]
      }
    }
  ],
  "$defs": {
    "cell": {
      "type": "string",
      "enum": ["free", "obstacle", "unknown", "boundary"]
    },
    "start": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "heading": {
          "type": "string",
          "enum": ["up", "right", "down", "left"]
        }
      },
      "required": ["row", "column", "heading"],
      "additionalProperties": false
    }
  }
}
